# Postgres in production (Supabase, Neon or a server in Kazakhstan). Empty = embedded PGlite in .data/pglite
DATABASE_URL=
DB_AUTO_MIGRATE=0
DATABASE_POOL_SIZE=5
# Embedded PGlite directory when DATABASE_URL is empty (default .data/pglite)
PGLITE_DIR=
# Public address of the site, used in notification links (default http://localhost:3000)
APP_URL=
# Required in production: random 32+ characters
AUTH_SECRET=
# Comma-separated phones that become administrators on login
ADMIN_PHONES=
# Show login codes on screen outside development (never in real production)
AUTH_DEV_CODES=0
# Login codes sent to all numbers per 24 hours (each one is a paid SMS once a gateway is set). Default 2000
OTP_DAILY_LIMIT=
# SMS gateway for login codes (JSON POST {to, text})
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# 17VIN API (server-only). Empty = fixture mode with synthetic data
TETIX_17VIN_USER=
TETIX_17VIN_PASSWORD=
TETIX_17VIN_DAILY_LIMIT=200
# Telegram bot for notifications. Without a token notifications go to the server log
TELEGRAM_BOT_TOKEN=
# Bot username without @: enables "Подключить Telegram" in the profile
TELEGRAM_BOT_USERNAME=
# Random secret for the webhook; without it /api/telegram/webhook rejects every update
TELEGRAM_WEBHOOK_SECRET=
# File storage: local directory (default .data/uploads)
UPLOAD_DIR=
